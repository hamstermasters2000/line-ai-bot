# LINE Messaging API (จาก LINE Developer Console)
LINE_CHANNEL_ACCESS_TOKEN=ใส่_token_ของคุณ_ที่นี่
LINE_CHANNEL_SECRET=ใส่_secret_ของคุณ_ที่นี่

# Groq API (จาก https://console.groq.com)
GROQ_API_KEY=ใส่_groq_key_ที่นี่

# Claude API (จาก https://console.anthropic.com) — ตัวหลัก
# ถ้าไม่ใส่ — บอทจะใช้แค่ Groq แทน
CLAUDE_API_KEY=ใส่_claude_key_ที่นี่
CLAUDE_MODEL=claude-haiku-4-5-20251001

# AI_PROVIDER=claude (default) ใช้ Claude ก่อน สลับไป Groq อัตโนมัติถ้า Claude error/token limit เกิน
# AI_PROVIDER=groq ใช้ Groq ก่อน สลับไป Claude อัตโนมัติถ้า Groq พัง
AI_PROVIDER=claude

# Upstash Redis (จาก https://console.upstash.com → สร้าง Redis database → copy REST URL/Token)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=ใส่_token_ที่นี่

# Discord Bot (จาก https://discord.com/developers/applications → Bot → Token)
# ถ้าไม่ใส่ — Discord จะถูกข้ามไป LINE ยังทำงานปกติ
DISCORD_BOT_TOKEN=ใส่_discord_token_ที่นี่

# Bot Config
BOT_NAME=มีโซ
PORT=3000
