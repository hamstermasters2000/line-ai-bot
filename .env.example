# LINE Messaging API (จาก LINE Developer Console)
LINE_CHANNEL_ACCESS_TOKEN=ใส่_token_ของคุณ_ที่นี่
LINE_CHANNEL_SECRET=ใส่_secret_ของคุณ_ที่นี่

# Groq API (จาก https://console.groq.com)
GROQ_API_KEY=ใส่_groq_key_ที่นี่

# Upstash Redis (จาก https://console.upstash.com → สร้าง Redis database → copy REST URL/Token)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=ใส่_token_ที่นี่

# Bot Config
BOT_NAME=น้องAI
PORT=3000
